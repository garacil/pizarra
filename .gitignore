# Local-only quarantine. Nothing below this directory is ever public.
/.private/

# Hidden local state, credentials, and development-session metadata. Keep only
# this policy file and GitHub automation.
/.*
!/.gitignore
!/.github/
!/.github/**

# Retired in-tree runtime layout. Runtime state moved out of the repository, so
# anything reappearing here is a stray hub lock or store from a run started
# without an explicit --config. It must never become a commit, and it must never
# block a release: `make publish` refuses a dirty tree, and an empty lock file
# in a path the project deliberately retired is not a reason to hold a release.
/conf/

# Compiler and build artifacts
/build/
/config.mk
/pizarra
/tiza
/pzweb
*-debug
*.o
*.ppu
*.compiled
*.or
*.a
link*.res
ppas.sh
fpcmade*

# Runtime configuration/state belongs only under /etc/pizarra and
# /var/lib/pizarra. Deliberately do NOT ignore old repo-local conf/store paths:
# if one reappears after retirement, Git must make the regression visible.

# Logs, backups, and release artifacts
*.log
/*-console.out
/pzweb.out
/releases/
/inventory.sqlite
/.nfs*

# Test output and caches
/tests/
__pycache__/
*.py[cod]

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*~
