# pzweb.conf — authenticated web console
#
# Copy to /etc/pzweb/pzweb.conf and set mode 0600. The service refuses to
# start if this file is more permissive. Keep the default loopback binding and
# use an encrypted tunnel or private overlay for remote access. pzweb is not
# proxy-aware; ordinary HTTPS reverse-proxy Origin headers break mutations.

[pizarra]
host = 127.0.0.1
port = 7010
secret = CHANGE-ME-BEFORE-STARTING
self = pzweb

[web]
listen = 127.0.0.1
port = 7080
allow_from = 127.0.0.1
host = 127.0.0.1:7080
origin = http://127.0.0.1:7080
static = /usr/local/share/pizarra/web/apps
# shared = /var/lib/pizarra/shared

user = operator
# Generate without echoing the password or storing it in shell history:
# read -r -s -p 'Password: ' PZWEB_PASSWORD; printf '\n'
# printf '%s' "$PZWEB_PASSWORD" | sha256sum | cut -d' ' -f1
# unset PZWEB_PASSWORD
password_sha256 = replace-with-a-64-character-lowercase-sha256-digest
