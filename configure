#!/bin/sh

# Configure the local pizarra build without probing or recording operational
# configuration. The generated config.mk contains installation paths only.

set -eu

prefix=/usr/local
bindir=
datadir=

usage() {
  cat <<'EOF'
Usage: ./configure [OPTIONS]

Options:
  --prefix=PATH   installation prefix (default: /usr/local)
  --bindir=PATH   executable directory (default: PREFIX/bin)
  --datadir=PATH  data root (default: PREFIX/share/pizarra)
  -h, --help      show this help

The script checks the build tools and release architecture, then writes
config.mk. It never reads runtime configuration, credentials, or state.
EOF
}

fail() {
  printf '%s\n' "configure: error: $*" >&2
  exit 1
}

safe_absolute_path() {
  path_value=$1
  path_name=$2
  case "$path_value" in
    /*) ;;
    *) fail "$path_name must be an absolute path" ;;
  esac
  case "$path_value" in
    *[!A-Za-z0-9_./+-]*)
      fail "$path_name contains unsupported characters"
      ;;
  esac
  case "/$path_value/" in
    */../*|*/./*) fail "$path_name must not contain . or .. components" ;;
  esac
}

for option in "$@"; do
  case "$option" in
    --prefix=*) prefix=${option#*=} ;;
    --bindir=*) bindir=${option#*=} ;;
    --datadir=*) datadir=${option#*=} ;;
    -h|--help) usage; exit 0 ;;
    --prefix|--bindir|--datadir)
      fail "$option requires =PATH"
      ;;
    *) fail "unknown option: $option (run ./configure --help)" ;;
  esac
done

while [ "$prefix" != / ] && [ "${prefix%/}" != "$prefix" ]; do
  prefix=${prefix%/}
done

[ -n "$prefix" ] || fail "--prefix must not be empty"
[ -n "$bindir" ] || bindir=${prefix%/}/bin
[ -n "$datadir" ] || datadir=${prefix%/}/share/pizarra

safe_absolute_path "$prefix" --prefix
safe_absolute_path "$bindir" --bindir
safe_absolute_path "$datadir" --datadir

for tool_name in fpc gcc make strip uname; do
  command -v "$tool_name" >/dev/null 2>&1 || fail "required tool not found: $tool_name"
done

target_arch=$(uname -m)
case "$target_arch" in
  x86_64|aarch64|i386|i486|i586|i686) ;;
  *) fail "unsupported release architecture: $target_arch" ;;
esac

fpc_version=$(fpc -iV 2>/dev/null) || fail "Free Pascal did not report its version"
[ -n "$fpc_version" ] || fail "Free Pascal reported an empty version"

tmp_file=config.mk.tmp
trap 'rm -f "$tmp_file"' EXIT HUP INT TERM
umask 022
{
  printf '%s\n' '# Generated by ./configure. Do not commit this file.'
  printf 'PREFIX := %s\n' "$prefix"
  printf 'BINDIR := %s\n' "$bindir"
  printf 'DATADIR := %s\n' "$datadir"
} > "$tmp_file"
mv -f "$tmp_file" config.mk

printf '%s\n' \
  "configure: Free Pascal $fpc_version" \
  "configure: architecture $target_arch" \
  "configure: prefix       $prefix" \
  "configure: bindir       $bindir" \
  "configure: datadir      $datadir" \
  'configure: wrote config.mk' \
  'configure: now run make test'
