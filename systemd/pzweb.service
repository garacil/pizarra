[Unit]
Description=pzweb operations console for pizarra
After=network-online.target pizarra.service
Wants=network-online.target
Requires=pizarra.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
WorkingDirectory=/usr/local/share/pizarra
ExecStart=/usr/local/bin/pzweb --config /etc/pizarra/pzweb.conf
ExecStartPost=/usr/local/bin/pzweb --config /etc/pizarra/pzweb.conf --health --wait 30
TimeoutStartSec=45
Restart=on-failure
RestartSec=3

# Root matches the migration defaults. A dedicated pzweb account is preferred
# on new installations; set PZWEB_OWNER/PZWEB_GROUP during migration and
# override User/Group here as one coordinated change.

[Install]
WantedBy=multi-user.target
