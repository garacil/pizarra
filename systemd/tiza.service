[Unit]
Description=tiza team-host delivery daemon
After=network-online.target
Wants=network-online.target
# Restart=always would loop forever on a config the daemon refuses at startup
# (a wrong-owner /etc/pizarra/tiza.conf restored by a `cp -p` rollback did ~196
# restarts at RestartSec=5 on one host). Stop after 5 failed starts in 60 s so a
# bad config surfaces as a failed unit instead of a tight loop; a transient
# failure that recovers within a couple of restarts is unaffected.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
UMask=0077
StateDirectory=pizarra
StateDirectoryMode=0700
WorkingDirectory=/
ExecStart=/usr/local/bin/tiza daemon --config /etc/pizarra/tiza.conf
Restart=always
RestartSec=3
# A daemon restart must never propagate a stop signal to the tmux server or its
# agent panes. The watchdog recreates only missing sessions on its next pass.
KillMode=process

# Run this service as the account that owns the configured tmux sessions. Root
# matches the existing deployment. StateDirectory owns /var/lib/pizarra, so a
# tiza instance sharing a host/store with the hub must use the same User/Group;
# otherwise point [daemon] state at a separately owned private directory.

[Install]
WantedBy=multi-user.target
